# Neon's POOLED connection string (the "-pooler" hostname suffix), not the
# direct one — see packages/db's ADR 0012.
DATABASE_URL=

# Frontend origin allowed to call this API via CORS. Placeholder until a real
# origin is deployed — same situation as the CSP's connect-src (see apps/web's
# ADR 0007/0008).
API_CORS_ORIGIN=http://localhost:5173
