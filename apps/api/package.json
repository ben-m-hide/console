{
	"name": "@console-next/api",
	"private": true,
	"version": "1.1.0",
	"type": "module",
	"scripts": {
		"dev": "bun run --watch src/index.ts",
		"typecheck": "tsc -b --noEmit",
		"test": "vitest run && bun run check:openapi",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"check:openapi": "bun run scripts/check-openapi.ts"
	},
	"dependencies": {
		"@console-next/db": "workspace:*",
		"@console-next/shared": "workspace:*",
		"@hono/zod-openapi": "1.5.2",
		"@scalar/hono-api-reference": "0.11.13",
		"drizzle-orm": "0.45.2",
		"hono": "4.13.1",
		"hono-rate-limiter": "^0.5.3",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "^4.1.10",
		"vitest": "^4.1.10"
	}
}
