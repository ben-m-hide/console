# Origin of the apps/api backend this frontend calls.
#
# 4100, not Hono's bare default 3000, deliberately: apps/api's run-api skill
# documents a real case where another process held [::1]:3000 and requests
# silently reached it instead — a plausible-looking wrong response, no bind
# error. Its smoke.sh serves 4100 for the same reason; match it.
#
# Placeholder until a real origin is deployed — same situation as the CSP's
# connect-src (ADR 0007/0008) and apps/api's API_CORS_ORIGIN.
VITE_API_URL=http://localhost:4100
