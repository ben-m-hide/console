{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["**", "!**/src/routeTree.gen.ts", "!**/public", "!**/cdk.out"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"useArrowFunction": "error"
			},
			"correctness": {
				"noNestedComponentDefinitions": "error",
				"noReactPropAssignments": "error",
				"useUniqueElementIds": "error"
			},
			"performance": {
				"noJsxPropsBind": "error"
			},
			"style": {
				"useConsistentArrayType": {
					"level": "error",
					"options": {
						"syntax": "generic"
					}
				},
				"useNamingConvention": {
					"level": "error",
					"options": {
						"strictCase": false
					}
				}
			},
			"nursery": {
				"useExplicitReturnType": "error",
				"noFloatingPromises": "error",
				"noMisusedPromises": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"linter": {
			"enabled": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"sortBareImports": true,
						"groups": [
							{
								"kind": "!bare",
								"source": [":BUN:", ":NODE:"]
							},
							":BLANK_LINE:",
							{
								"kind": "!bare",
								"source": [":PACKAGE_WITH_PROTOCOL:", ":PACKAGE:"]
							},
							":BLANK_LINE:",
							{
								"kind": "!bare",
								"source": ":ALIAS:"
							},
							":BLANK_LINE:",
							{
								"kind": "!bare",
								"source": ":PATH:"
							},
							":BLANK_LINE:",
							{
								"kind": "bare"
							}
						]
					}
				}
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/sportmonks-types.ts", "**/sportmonks-fixtures.ts"],
			"linter": {
				"rules": {
					"style": {
						"useNamingConvention": "off"
					}
				}
			}
		}
	]
}
