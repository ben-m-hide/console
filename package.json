{
	"name": "console-next",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "bun@1.3.8",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "vite",
		"codegen": "tsr generate",
		"build": "bun run codegen && tsc -b && vite build",
		"preview": "vite preview",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"format:md": "prettier --write '**/*.md'",
		"format:md:check": "prettier --check '**/*.md'",
		"typecheck": "bun run codegen && tsc -b --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"prepare": "lefthook install"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@mantine/core": "^9.5.1",
		"@mantine/hooks": "^9.5.1",
		"@tanstack/react-form": "^1.33.3",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-router": "^1.170.22",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"zod": "^4.4.3",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@tanstack/devtools-vite": "^0.8.3",
		"@tanstack/react-devtools": "^0.10.9",
		"@tanstack/react-form-devtools": "^0.2.33",
		"@tanstack/react-query-devtools": "^5.101.4",
		"@tanstack/react-router-devtools": "^1.167.1",
		"@tanstack/router-cli": "^1.167.27",
		"@tanstack/router-plugin": "^1.168.27",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.3",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.4",
		"@vitest/coverage-v8": "^4.1.10",
		"aws-cdk": "2.1135.1",
		"aws-cdk-lib": "2.263.0",
		"axe-core": "^4.13.0",
		"constructs": "10.8.1",
		"jsdom": "^30.0.1",
		"lefthook": "^2.1.10",
		"postcss": "^8.5.26",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"prettier": "^3.9.6",
		"typescript": "^7.0.2",
		"vite": "^8.2.0",
		"vite-plugin-bundlesize": "^0.3.0",
		"vitest": "^4.1.10"
	}
}
