{
	"name": "console-next",
	"private": true,
	"version": "1.1.0",
	"type": "module",
	"packageManager": "bun@1.3.8",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun run --filter ./apps/web dev",
		"codegen": "bun run --filter ./apps/web codegen && bun run --filter ./packages/shared codegen",
		"build": "bun run --filter ./apps/web build",
		"preview": "bun run --filter ./apps/web preview",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"format:md": "prettier --write '**/*.md'",
		"format:md:check": "prettier --check '**/*.md'",
		"typecheck": "bun run codegen && tsc -b --noEmit",
		"test": "bun run --filter ./apps/web test && bun run --filter ./packages/shared test",
		"test:watch": "bun run --filter ./apps/web test:watch",
		"test:coverage": "bun run --filter ./apps/web test:coverage",
		"e2e": "bun run --filter ./packages/e2e test",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@types/node": "^26.2.0",
		"aws-cdk": "2.1135.1",
		"aws-cdk-lib": "2.263.0",
		"constructs": "10.8.1",
		"lefthook": "^2.1.10",
		"prettier": "^3.9.6",
		"typescript": "^7.0.2"
	},
	"overrides": {
		"nanoid": "3.3.18"
	}
}
